const btn=document.getElementById('langBtn');let lang='de';
btn.addEventListener('click',()=>{lang=lang==='de'?'no':'de';document.documentElement.lang=lang;document.querySelectorAll('[data-de]').forEach(el=>{el.textContent=el.dataset[lang]});btn.textContent=lang==='de'?'NO':'DE'});
document.getElementById('year').textContent=new Date().getFullYear();
const cards=[...document.querySelectorAll('.card')];let current=0;
const box=document.createElement('div');box.className='lightbox';box.hidden=true;box.innerHTML='<button class="lightboxClose" aria-label="Bild schließen">×</button><button class="lightboxPrev" aria-label="Vorheriges Bild">‹</button><img alt=""><button class="lightboxNext" aria-label="Nächstes Bild">›</button>';document.body.appendChild(box);
const boxImg=box.querySelector('img');function show(index){current=(index+cards.length)%cards.length;const img=cards[current].querySelector('img');boxImg.src=img.src;boxImg.alt=img.alt;box.hidden=false;document.body.style.overflow='hidden'}function close(){box.hidden=true;document.body.style.overflow=''}
cards.forEach((card,index)=>{card.tabIndex=0;card.addEventListener('click',()=>show(index));card.addEventListener('keydown',e=>{if(e.key==='Enter')show(index)})});
box.querySelector('.lightboxClose').addEventListener('click',close);box.querySelector('.lightboxPrev').addEventListener('click',()=>show(current-1));box.querySelector('.lightboxNext').addEventListener('click',()=>show(current+1));box.addEventListener('click',e=>{if(e.target===box)close()});document.addEventListener('keydown',e=>{if(box.hidden)return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')show(current-1);if(e.key==='ArrowRight')show(current+1)});

